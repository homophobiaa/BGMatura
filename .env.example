# Example values only. db:start creates .env.local with generated local credentials
# only when that file does not exist. For another target, replace this placeholder.
# No NEXT_PUBLIC_* variables are required by the foundation.
DATABASE_URL=postgresql://example_user:example_password@localhost:5432/bgmatura
# Set the actual application origin before deploying, for absolute canonical URLs.
# No credentials, path, query, or fragment. Optional for local/CI builds.
SITE_URL=http://localhost:3000
# Admin-only Google OAuth. See documentation/FEATURES/admin-authentication.md.
# Set secrets only in ignored .env.local or the hosting provider.
# Public builds/pages need no authentication credentials.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
# Tests use the dedicated local test cluster by default; never reuse DATABASE_URL.
# Optional TEST_DATABASE_URL must target bgmatura_test as user and database on
# localhost/127.0.0.1 port 55433, without URL options. See documentation/DATABASE.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum Subject {
  BULGARIAN_LANGUAGE
  LITERATURE
}

model Author {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  slug      String            @unique
  context   String?
  status    PublicationStatus @default(DRAFT)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@index([status, name, id])
}

model Topic {
  id        String            @id @default(uuid()) @db.Uuid
  title     String
  slug      String
  subject   Subject
  parentId  String?           @db.Uuid
  parent    Topic?            @relation("TopicHierarchy", fields: [parentId, subject], references: [id, subject], onDelete: Restrict, onUpdate: Restrict)
  children  Topic[]           @relation("TopicHierarchy")
  position  Int               @default(0)
  status    PublicationStatus @default(DRAFT)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([id, subject])
  @@unique([subject, slug])
  @@index([subject, parentId, position, title, id])
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Better Auth identities are administrators only; students remain anonymous.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]

  @@map("AuthUser")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("AuthSession")
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("AuthAccount")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("AuthVerification")
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum Subject {
  BULGARIAN_LANGUAGE
  LITERATURE
}

model Author {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  slug      String            @unique
  context   String?
  status    PublicationStatus @default(DRAFT)
  works     Work[]
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@index([status, name, id])
}

model Topic {
  id        String            @id @default(uuid()) @db.Uuid
  title     String
  slug      String
  subject   Subject
  parentId  String?           @db.Uuid
  parent    Topic?            @relation("TopicHierarchy", fields: [parentId, subject], references: [id, subject], onDelete: Restrict, onUpdate: Restrict)
  children  Topic[]           @relation("TopicHierarchy")
  position  Int               @default(0)
  status    PublicationStatus @default(DRAFT)
  questions QuestionTopic[]
  lessons   Lesson[]
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([id, subject])
  @@unique([subject, slug])
  @@index([subject, parentId, position, title, id])
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_RESPONSE
  EXTENDED_RESPONSE
  ARGUMENTATIVE_WRITING
}

/// A language lesson belongs to one required primary topic (which may be a subtopic).
model Lesson {
  id        String            @id @default(uuid()) @db.Uuid
  title     String
  slug      String            @unique
  topicId   String            @db.Uuid
  subject   Subject           @default(BULGARIAN_LANGUAGE)
  topic     Topic             @relation(fields: [topicId, subject], references: [id, subject], onDelete: Restrict, onUpdate: Restrict)
  /// Versioned learningContentSchema document, never raw HTML.
  content   Json              @default("{\"version\":1,\"blocks\":[]}")
  status    PublicationStatus @default(DRAFT)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@index([topicId, status, title, id])
}

enum AssessmentMode {
  OBJECTIVE
  SELF_REVIEW
  UNGRADED
}

/// One shared bank for practice and exams; exams link to questions, never copy them.
/// The CHECK constraints in the migration decide which fields each type/mode needs.
model Question {
  id                String              @id @default(uuid()) @db.Uuid
  subject           Subject
  type              QuestionType
  prompt            String
  assessmentMode    AssessmentMode
  /// Objective questions only. Decimal so half points stay exact.
  maximumPoints     Decimal?            @db.Decimal(6, 2)
  /// Objective questions only: shown after the answer is graded.
  explanation       String?
  /// Written (self-review/ungraded) questions only.
  referenceGuidance String?
  /// Written questions only: JSON array of rubric criteria, validated by the application.
  rubric            Json?
  /// Objective short-response questions only.
  acceptedAnswers   String[]            @default([])
  /// Multiple-choice questions only; a trigger requires it to be one of this question's own options.
  correctOptionId   String?             @db.Uuid
  correctOption     QuestionOption?     @relation("CorrectOption", fields: [correctOptionId], references: [id], onDelete: NoAction, onUpdate: Restrict)
  options           QuestionOption[]    @relation("QuestionOptions")
  topics            QuestionTopic[]
  works             QuestionWork[]
  provenance        QuestionProvenance?
  exams             ExamQuestion[]
  status            PublicationStatus   @default(DRAFT)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([id, type])
  @@unique([id, subject])
  @@index([subject, status, createdAt, id])
}

model QuestionOption {
  id                  String       @id @default(uuid()) @db.Uuid
  questionId          String       @db.Uuid
  /// Always MULTIPLE_CHOICE; the composite foreign key makes the database reject options on other types.
  questionType        QuestionType
  question            Question     @relation("QuestionOptions", fields: [questionId, questionType], references: [id, type], onDelete: Cascade, onUpdate: Restrict)
  correctForQuestions Question[]   @relation("CorrectOption")
  text                String
  position            Int

  @@unique([questionId, position])
}

/// A literary work by exactly one author. Study fields may be incomplete while a draft.
model Work {
  id             String            @id @default(uuid()) @db.Uuid
  title          String
  slug           String            @unique
  authorId       String            @db.Uuid
  author         Author            @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  genre          String?
  summary        String?
  /// Ordered study lists. Items are never blank; an empty list means "none recorded".
  themes         String[]          @default([])
  /// Empty for works where characters do not apply (for example a lyric poem), which is valid.
  characters     String[]          @default([])
  importantIdeas String[]          @default([])
  interpretation String?
  status         PublicationStatus @default(DRAFT)
  questions      QuestionWork[]
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  @@index([authorId, title, id])
  @@index([status, title, id])
}

enum QuestionOrigin {
  ORIGINAL
  ADAPTED
  OFFICIAL
}

enum ReviewStatus {
  UNREVIEWED
  REVIEWED
}

/// Links a question to a topic of the same subject. Deleting a linked topic is refused; unlink first.
model QuestionTopic {
  questionId String   @db.Uuid
  topicId    String   @db.Uuid
  /// Copied from both sides by the composite foreign keys, so the question and topic must share it.
  subject    Subject
  question   Question @relation(fields: [questionId, subject], references: [id, subject], onDelete: Cascade, onUpdate: Restrict)
  topic      Topic    @relation(fields: [topicId, subject], references: [id, subject], onDelete: Restrict, onUpdate: Restrict)

  @@id([questionId, topicId])
  @@index([topicId, questionId])
}

/// Optionally links a literature question to a relevant work. Works only exist for literature.
model QuestionWork {
  questionId String   @db.Uuid
  workId     String   @db.Uuid
  /// Always LITERATURE; the composite foreign key rejects a question of another subject.
  subject    Subject  @default(LITERATURE)
  question   Question @relation(fields: [questionId, subject], references: [id, subject], onDelete: Cascade, onUpdate: Restrict)
  work       Work     @relation(fields: [workId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([questionId, workId])
  @@index([workId, questionId])
}

/// Editorial provenance of a question. `origin` and `attribution` may be shown to students;
/// everything else here is private to editors and must never reach a public projection.
/// A question without a row is simply unclassified.
model QuestionProvenance {
  questionId      String         @id @db.Uuid
  question        Question       @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  origin          QuestionOrigin
  /// Public credit line, required before an adapted or official question can be marked reviewed.
  attribution     String?
  /// Private: exact citation such as document, page, or address.
  sourceReference String?
  /// Private: who wrote or adapted the question.
  editorName      String?
  reviewStatus    ReviewStatus   @default(UNREVIEWED)
  reviewedBy      String?
  reviewedAt      DateTime?      @db.Timestamptz(3)
  reviewNotes     String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
}

/// An immutable copy of a published question as it was when an attempt began, so completed
/// results never change with later edits, unpublishing, or deletion of the question.
/// `content` holds answer keys and must stay on the server.
model QuestionSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  /// The question this version was captured from. Deliberately not a foreign key: editing,
  /// unpublishing, or deleting the question must never alter or block a snapshot.
  questionId    String   @db.Uuid
  /// Version of the layout of `content`; readers refuse versions they do not know.
  formatVersion Int
  content       Json
  /// SHA-256 of the exact content text, so an unchanged question reuses one snapshot.
  contentHash   String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  attemptQuestions AttemptQuestion[]

  @@unique([id, questionId])
  @@unique([questionId, contentHash])
  @@index([questionId, createdAt])
}

enum ExamVerification {
  UNVERIFIED
  CONDITIONAL
  VERIFIED
}

model ExamConfiguration {
  id           String           @id @default(uuid()) @db.Uuid
  targetYear   Int
  session      String
  version      Int
  verification ExamVerification
  blueprint    Json
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  exams        Exam[]
  attempts     Attempt[]

  @@unique([targetYear, session, version])
}

model Exam {
  id              String             @id @default(uuid()) @db.Uuid
  title           String
  description     String
  classification  QuestionOrigin
  attribution     String?
  status          PublicationStatus  @default(DRAFT)
  configurationId String             @db.Uuid
  configuration   ExamConfiguration  @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  questions       ExamQuestion[]
  attempts        Attempt[]
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt, id])
}

model ExamQuestion {
  examId     String   @db.Uuid
  questionId String   @db.Uuid
  position   Int
  points     Decimal  @db.Decimal(6, 2)
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([examId, questionId])
  @@unique([examId, position])
  @@index([questionId])
}

enum AttemptMode {
  PRACTICE
  EXAM
}

enum AttemptState {
  ACTIVE
  SUBMITTED
  EXPIRED
}

model Attempt {
  id              String             @id @default(uuid()) @db.Uuid
  mode            AttemptMode
  state           AttemptState       @default(ACTIVE)
  ownerDigest     String             @unique
  accessUntil     DateTime           @db.Timestamptz(3)
  startedAt       DateTime           @db.Timestamptz(3)
  deadline        DateTime?          @db.Timestamptz(3)
  completedAt     DateTime?          @db.Timestamptz(3)
  position        Int                @default(0)
  topicId         String?            @db.Uuid
  examId          String?            @db.Uuid
  exam            Exam?              @relation(fields: [examId], references: [id], onDelete: Restrict)
  configurationId String?            @db.Uuid
  configuration   ExamConfiguration? @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  title           String
  result          Json?
  questions       AttemptQuestion[]

  @@index([accessUntil])
  @@index([examId])
  @@index([configurationId])
}

/// Ordered snapshot and response are scoped to one attempt. Exam drafts have no evaluation.
model AttemptQuestion {
  attemptId  String           @db.Uuid
  questionId String           @db.Uuid
  snapshotId String           @db.Uuid
  position   Int
  /// The objective maximum at start. Written blueprint points are not a score.
  points     Decimal?         @db.Decimal(6, 2)
  answer     Json?
  evaluation Json?
  correct    Boolean?
  revision   Int              @default(0)
  savedAt    DateTime?        @db.Timestamptz(3)
  attempt    Attempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  snapshot   QuestionSnapshot @relation(fields: [snapshotId, questionId], references: [id, questionId], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@unique([attemptId, position])
  @@index([snapshotId, questionId])
}
